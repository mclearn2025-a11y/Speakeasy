# Cloudflare Pages settings for Speakeasy
# Always check for a new version of the app shell, so updates reach families right away.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# Photos and icons never change at the same address, so they can be kept a long time.
/photos/*
  Cache-Control: public, max-age=2592000
/icons/*
  Cache-Control: public, max-age=2592000
/symbols/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000
# Safety
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
